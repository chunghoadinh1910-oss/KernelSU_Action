# KernelSU Action -- build profile
CONFIG_ENV=config.env

# ============================================================ Kernel source ==
# Nguồn kernel dành cho Note 9 (Exynos 9810) - Nhánh LineageOS 20 (Android 13)
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_samsung_exynos9810
KERNEL_SOURCE_BRANCH=lineage-20
KERNEL_CONFIG=crownlte_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=crownlte
ADD_LOCALVERSION_TO_FILENAME=false

# Lưu ý: Giữ nguyên phần Clang 2022 vì kernel 4.9 rất kén phiên bản Clang mới
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
USE_CUSTOM_GCC_32=false

# =============================================================== KernelSU ===
# Sử dụng ReSukiSU (rất tốt cho kernel 4.9 non-GKI)
KSU_VARIANT=resukisu
KSU_REF=

# Rất quan trọng: Bắt buộc dùng manual cho kernel 4.9, không dùng kprobes
KSU_HOOK_MODE=manual

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# ReSukiSU đã tích hợp sẵn SUSFS, để false để tránh xung đột patch
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# Bắt buộc bật đối với kernel cũ (dưới 5.9)
ENABLE_PATH_UMOUNT=true 

# Bật để xóa fingerprint (ẩn root tốt hơn)
ENABLE_HIDE_STUFF=true

# Tắt KPM để tránh lỗi build (KPM thường không ổn định trên kernel 4.9)
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true

# Tắt LTO và CC_WERROR để tránh lỗi "Error 2" do compiler quá khắt khe
DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
