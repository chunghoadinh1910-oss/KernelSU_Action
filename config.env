# KernelSU Action -- build profile
CONFIG_ENV=config.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_samsung_exynos9810
KERNEL_SOURCE_BRANCH=lineage-20
KERNEL_CONFIG=exynos9810-crownlte_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=crownlte
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ===
# Chọn SukiSU-Ultra
KSU_VARIANT=sukisu-ultra
# Sử dụng nhánh "builtin" để có sẵn SUSFS, tránh xung đột
KSU_REF=builtin

# SukiSU-Ultra cũng hỗ trợ manual hooks
KSU_HOOK_MODE=manual

# =================================================================== SUSFS ==
# Để false vì đã dùng KSU_REF=builtin (tích hợp sẵn SUSFS)
ENABLE_SUSFS=false

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=true 
ENABLE_HIDE_STUFF=true
# Tắt KPM để tránh lỗi build
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
